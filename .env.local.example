# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun. Vercel'de aynı
# değişkenleri Project Settings > Environment Variables altına girin.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# --- Bot ---
# Web test sohbeti ve WhatsApp aynı botu kullanır: "groq" (varsayılan) veya "anthropic"
BOT_SAGLAYICI=groq
GROQ_API_KEY=gsk_...
# GROQ_MODEL=qwen/qwen3.8-27b
# Cevap başına en fazla çıktı token'ı (varsayılan 800; ücretsiz katman dakikalık sınırı 1000)
# GROQ_MAX_TOKENS=800
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7

# --- Super admin paneli (/super) ---
# En az 12 karakter; yoksa panel kapalı kalır
SUPER_ADMIN_PASSWORD=uzun-ve-rastgele-bir-sifre

# --- WhatsApp ---
# "meta" (varsayılan) veya "twilio"
WHATSAPP_PROVIDER=meta

# Twilio (WHATSAPP_PROVIDER=twilio ise). Webhook imzası TWILIO_AUTH_TOKEN ile doğrulanır.
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_WHATSAPP_FROM=+14155238886

# Meta Cloud API (WHATSAPP_PROVIDER=meta ise)
META_ACCESS_TOKEN=EAAxx...
META_PHONE_NUMBER_ID=12345678
# Webhook imzası için zorunlu: Meta App Dashboard > App settings > Basic > App secret
META_APP_SECRET=
# Graph API sürümü (boşsa v24.0). Meta eski sürümleri kapattığında buradan güncellenir.
META_GRAPH_VERSION=
WHATSAPP_VERIFY_TOKEN=uzun-rastgele-bir-deger

# Proxy arkasındaysan Twilio'ya girdiğin webhook adresini birebir yaz (imza doğrulaması için)
WHATSAPP_WEBHOOK_URL=
# Sadece yerel geliştirmede imza kontrolünü kapatmak için 1 yap (production'da etkisiz)
WHATSAPP_IMZA_ATLA=

# Mesajı alan numara hiçbir işletmeye kayıtlı değilse kullanılacak işletme (opsiyonel)
DEFAULT_ISLETME_ID=

# --- Kendiliğinden mesaj (hatırlatma, salon sahibine WhatsApp bildirimi) ---
# Varsayılan KAPALI: uygulama yalnızca gelen mesajlara cevap verir. Açmak için "acik" yaz.
# Açarsan aşağıdaki onaylı şablonlar gerekir ve Meta mesaj başına ücret alır.
NEXT_PUBLIC_PROAKTIF_MESAJLAR=

# --- Randevu hatırlatma ---
# Vercel Cron bu değeri Authorization başlığıyla gönderir; uzun rastgele bir değer
CRON_SECRET=
# Onaylı şablon: Meta'da şablon adı, Twilio'da Content SID (HX...). Boşsa hatırlatma gönderilmez.
WHATSAPP_HATIRLATMA_SABLONU=
# Meta şablon dili
WHATSAPP_SABLON_DIL=tr

# --- Koruma ve uyarılar (hepsi isteğe bağlı) ---
# Bir salonun günlük toplam bot mesajı sınırı (boşsa 1500)
BOT_SALON_GUNLUK_SINIR=
# Uyarılar süper admin panelinde görünür. İsteğe bağlı dış kanal: Slack/Discord webhook ve/veya Telegram botu
UYARI_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Şifre sıfırlama ve KVKK aydınlatma bağlantısı için site adresi (Vercel'de boşsa VERCEL_PROJECT_PRODUCTION_URL kullanılır)
NEXT_PUBLIC_SITE_URL=

# --- Berbere randevu bildirimi (isteğe bağlı) ---
# E-posta: Resend API anahtarı ve gönderen adresi (alan adını Resend'de doğrula)
RESEND_API_KEY=
BILDIRIM_EPOSTA_GONDEREN=
# WhatsApp: onaylı şablon adı (metni README'de)
WHATSAPP_BILDIRIM_SABLONU=
